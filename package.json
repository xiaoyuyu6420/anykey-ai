{
  "name": "anykey-ai",
  "productName": "AnyKey AI",
  "version": "0.12.3",
  "description": "任意键盘的 AI 控制台：功能键区变 AI 快捷键 + RK R87 Pro AI 深度适配（无需官方 RK-AI 软件）",
  "main": "src/main/index.js",
  "author": "xiaoyuyu6420",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyuyu6420/anykey-ai.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron tools/dev.js",
    "listen": "node tools/listen.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac zip",
    "test": "node tests/kb-session-fixes.test.js && node tests/downdown-heal.test.js && node tests/profiles.test.js && node tests/macro.test.js && node tests/macro-abort.test.js && node tests/kb-session-race.test.js && node tests/denoise-engine.test.js && node tests/remote-safe.test.js && node tests/usb-port-policy.test.js && node tests/ailayer.test.js"
  },
  "devDependencies": {
    "animejs": "^4.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "three": "^0.185.1"
  },
  "dependencies": {
    "koffi": "^2.8.0",
    "node-hid": "^3.1.0"
  },
  "build": {
    "appId": "com.local.anykeyai",
    "productName": "AnyKey AI",
    "npmRebuild": false,
    "asarUnpack": [
      "vendor/deep-filter/**"
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "!**/hidapi/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "AnyKey-AI-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AnyKey-AI-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "identity": null
    }
  }
}
